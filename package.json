{
  "name": "klever-desktop",
  "version": "2.0.14",
  "description": "Native Android app testing with ChatGPT sign-in, recorded results, and scheduled runs.",
  "main": ".vite/build/index.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc && tsc -p tsconfig.main.json",
    "preview": "vite preview",
    "electron": "node scripts/electron-launch.cjs electron",
    "start": "node scripts/electron-launch.cjs start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "npm run build:siwc && electron-forge publish",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "test": "node --test tests/*.test.cjs",
    "build:local": "node scripts/build-local.cjs",
    "test:desktop": "node scripts/test-desktop.cjs",
    "verify:bundle": "node scripts/verify-bundle.js",
    "build:siwc": "npm run build --prefix vendor/sign-in-with-chatgpt-devkit",
    "prepare": "npm run build:siwc",
    "predev": "npm run build:siwc",
    "prestart": "npm run build:siwc",
    "pretypecheck": "npm run build:siwc",
    "prebuild:local": "npm run build:siwc",
    "pretest": "npm run build:siwc",
    "pretest:desktop": "npm run build:siwc",
    "prepackage": "npm run build:siwc",
    "premake": "npm run build:siwc",
    "test:account-ui": "node scripts/test-account-ui.cjs",
    "pretest:account-ui": "npm run build:siwc",
    "preelectron": "npm run build:local",
    "prepare:electron-runtime": "node scripts/electron-runtime.cjs"
  },
  "keywords": [
    "electron",
    "desktop",
    "android",
    "app-testing",
    "chatgpt",
    "scheduling"
  ],
  "author": "JooHyung Park",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FigmaAI/KleverDesktop.git"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@siwc/local": "file:vendor/sign-in-with-chatgpt-devkit/packages/local",
    "@siwc/react": "file:vendor/sign-in-with-chatgpt-devkit/packages/react",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "framer-motion": "^11.5.4",
    "i18next": "^25.7.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.454.0",
    "openai": "^7.27.0",
    "react": "^19.3.0",
    "react-day-picker": "^9.11.3",
    "react-dom": "^19.3.0",
    "react-i18next": "^16.5.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron-forge/publisher-github": "^7.10.2",
    "@electron/osx-sign": "^1.3.3",
    "@electron/universal": "^2.0.3",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.5.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^44.5.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "postcss": "^8.4.49",
    "shadcn": "^3.5.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.5.4",
    "vite": "^5.4.5",
    "vite-plugin-svgr": "^4.5.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
